# LinuxDo 账号
CDK_USERNAME=your_email@example.com
CDK_PASSWORD=your_password

# NodeLoc 账号（用于获取 vip.vip.sd 个人订阅）
NODELOC_USERNAME=your_nodeloc_email@example.com
NODELOC_PASSWORD=your_nodeloc_password

# VIP 订阅推送策略：1=仅链接变化才推送，0=每次都推送
VIP_PUSH_ONLY_ON_CHANGE=0

# Telegram 推送 (可选)
TG_BOT_TOKEN=123456:ABC-DEF
TG_CHAT_ID=123456789

# =========================
# Freestyle (api.freestyle.cc.cd)
# =========================
# 基础配置
FREESTYLE_BASE_URL=https://api.freestyle.cc.cd
FREESTYLE_PROXY=http://127.0.0.1:10808
FREESTYLE_LOGIN_MODE=linuxdo
FREESTYLE_IMPERSONATE=chrome136
FREESTYLE_TG_NOTIFY=1

# LinuxDo OAuth（推荐）
# 不填时会回退使用 CDK_USERNAME / CDK_PASSWORD
FREESTYLE_LINUXDO_USERNAME=your_linuxdo_email@example.com
FREESTYLE_LINUXDO_PASSWORD=your_linuxdo_password
# 可选：不填则脚本自动探测
FREESTYLE_LINUXDO_CLIENT_ID=

# 站点账号密码登录（可选）
FREESTYLE_USERNAME=
FREESTYLE_PASSWORD=

# =========================
# 太子公益站 (api.codeme.me)
# =========================
# Ubuntu 定时任务建议留空走直连；本地调试可填 http://127.0.0.1:10808
CODEME_PROXY=
# 可选：手动指定 LinuxDo client_id（不填则脚本自动探测）
CODEME_LINUXDO_CLIENT_ID=
# 可选：1=成功也推送，0=仅失败推送（默认 1）
CODEME_TG_ON_SUCCESS=1